{
  "name": "lg-website-inspector",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build:cli": "tsc -p tsconfig.cli.json",
    "inspect": "npm run build:cli --silent && node dist/scripts/inspect-initial.js",
    "report:initial": "npm run build:cli --silent && node dist/scripts/render-initial-report.js",
    "test:local": "npm run build:cli --silent && playwright test \"tests/initial-.*\\.spec\\.ts\" tests/page-targets.spec.ts tests/page-crawler.spec.ts tests/report-paths.spec.ts --project=chromium --workers=1 --reporter=line",
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:all": "playwright test",
    "report:html": "playwright show-report",
    "report:pdf": "tsx scripts/pdf.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "markdown-it": "^14.2.0"
  }
}
